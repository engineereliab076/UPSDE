# Required for production builds. Use the final HTTPS origin in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional privacy-conscious analytics (currently supports Plausible).
NEXT_PUBLIC_ANALYTICS_PROVIDER=
NEXT_PUBLIC_ANALYTICS_DOMAIN=
NEXT_PUBLIC_ANALYTICS_SCRIPT_URL=

# Optional Sentry error monitoring. Keep the auth token server-side.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_RELEASE=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
